{
  "name": "site",
  "version": "0.1.0",
  "description": "The Fuzzley Games portal and gallery.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/fetch-games.mjs --optional && vite",
    "dev": "node tools/fetch-games.mjs --optional && vite",
    "build": "node tools/fetch-games.mjs && vite build && node tools/inject-analytics.mjs",
    "games": "node tools/fetch-games.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint src tools vite.config.ts && yarn lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@angular/aria": "~22.2.4",
    "@angular/cdk": "~22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fz/style": "workspace:*",
    "@fz/ui": "workspace:*",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tar": "^7.5.22",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
