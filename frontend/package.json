{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "start": "node tools/fetch-games.mjs --optional && vite",
    "dev": "node tools/fetch-games.mjs --optional && vite",
    "build": "node tools/fetch-games.mjs && vite build && node tools/inject-analytics.mjs",
    "games": "node tools/fetch-games.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.node.json && yarn typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "yarn skills:check && (cd .. && eslint -c frontend/eslint.config.cjs frontend/src frontend/tools .agents) && yarn prettier:check",
    "skills:check": "node ../.agents/check-skill-references.mjs",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "prettier": "cd .. && prettier . --write",
    "prettier:check": "cd .. && prettier . --check"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.9",
    "tar": "^7.5.22",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
