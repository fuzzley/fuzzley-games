{
  // What runs in Node through Vite: the configs Vite and Vitest run, and the
  // specs under tools/. @fz/style's Vite plugin imports its modules by their
  // full file names, as Node needs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // eslint.config.js, which vitest.config.ts and a spec import, and the
    // scripts under tools/ carry their types in JSDoc;
    // tsconfig.scripts.json checks them.
    "allowJs": true,
    // The sound lab makes the design's take from the design's own recipes,
    // under docs/ at the repository's root.
    "rootDir": "../../..",
    "types": ["node", "vitest/globals"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tools/**/*.ts"]
}
