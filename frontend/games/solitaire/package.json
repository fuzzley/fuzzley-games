{
  "name": "fsolitaire",
  "version": "0.0.1",
  "description": "Solitaire game.",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:atlas": "node tools/build-card-atlas.mjs",
    "build:thumbs": "node tools/build-screenshot-thumbs.mjs",
    "stop": "node tools/stop-dev-servers.mjs",
    "skills:link": "node .agents/link-claude-skills.mjs",
    "skills:check": "node .agents/check-skill-references.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "yarn skills:check && eslint src test && yarn prettier:check",
    "tsc": "tsc --noEmit && yarn tsc:test",
    "tsc:test": "tsc --noEmit -p tsconfig.spec.json",
    "tsc:w": "tsc -w --noEmit",
    "verify": "yarn lint && yarn tsc && yarn build && yarn test",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzzley/fSolitaire.git"
  },
  "author": "Andrey Gavel",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/fuzzley/fSolitaire/issues"
  },
  "homepage": "https://github.com/fuzzley/fSolitaire#readme",
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "phaser": "^4.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
