{
  "name": "fsolitaire",
  "version": "0.0.1",
  "description": "Solitaire game.",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:atlas": "node tools/build-card-atlas.mjs",
    "skills:link": "node .agents/link-claude-skills.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "node -r ./register.cjs node_modules/eslint/bin/eslint.js src test",
    "tsc": "tsc && yarn tsc:test",
    "tsc:test": "tsc --noEmit -p tsconfig.spec.json",
    "tsc:w": "tsc -w",
    "verify": "yarn lint && yarn tsc && yarn build && yarn test",
    "prettier": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzzley/fSolitaire.git"
  },
  "author": "Andrey Gavel",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/fuzzley/fSolitaire/issues"
  },
  "homepage": "https://github.com/fuzzley/fSolitaire#readme",
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@angular/build": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/core-js": "^2.5.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "eslint": "^10.8.0",
    "phaser": "^4.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
