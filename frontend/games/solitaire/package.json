  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/core-js": "^2.5.8",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
