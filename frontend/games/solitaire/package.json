{
  "name": "solitaire",
  "version": "0.0.1",
  "description": "The Solitaire Collection: Klondike, Spider, FreeCell and dozens more.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:atlas": "node tools/build-card-atlas.mjs",
    "build:thumbs": "node tools/build-screenshot-thumbs.mjs",
    "capture:screenshots": "node tools/capture-screenshots.mjs",
    "stop": "node tools/stop-dev-servers.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint src test tools && yarn lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzzley/fuzzley-games.git",
    "directory": "frontend/games/solitaire"
  },
  "author": "Andrey Gavel",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/fuzzley/fuzzley-games/issues"
  },
  "homepage": "https://fuzzley.games/play/solitaire/",
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.1",
    "@analogjs/vitest-angular": "^2.8.1",
    "@angular/build": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.3.11",
    "jsdom": "^30.1.3",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@angular/aria": "~22.2.0",
    "@angular/cdk": "~22.2.0",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fz/game-ui": "workspace:*",
    "@fz/style": "workspace:*",
    "@fz/ui": "workspace:*",
    "phaser": "^4.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  }
}
