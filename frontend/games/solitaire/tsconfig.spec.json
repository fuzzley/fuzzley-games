{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "types": ["vitest/globals", "vite/client"],
    // Specs index boards by position throughout, as in game.tableaus[0], where
    // the flag would demand an assertion on every line for no protection.
    "noUncheckedIndexedAccess": false
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*", "test/**/*"]
}
