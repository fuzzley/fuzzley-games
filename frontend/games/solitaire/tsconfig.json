{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2022",
    "outDir": "./dist/",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "vitest/globals",
      "vite/client"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ],
  "include": [
    "src",
    "custom_typings"
  ],
  "typeRoots": [
    "./node_modules/@types",
    "./custom_typings"
  ]
}