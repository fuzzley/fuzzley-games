{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "ES6",
    "outDir": "./dist/",
    "lib": ["es5", "es6", "dom"],
    "types": ["vitest/globals", "vite/client"]
  },
  "exclude": ["custom_typings/**/*", "node_modules", "**/*.spec.ts"],
  "include": ["src/**/*"],
  "typeRoots": ["./node_modules/@types", "./custom_typings"]
}
