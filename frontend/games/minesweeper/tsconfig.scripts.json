{
  // The Node scripts under tools/, type-checked from their JSDoc. Node 26 is
  // the oldest runtime frontend/package.json allows, so its types are the
  // ones installed; the DOM's are for the functions a script runs in a page.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["tools/**/*.mjs"]
}
