{
  // What runs through Vite rather than in the app: the configs Vite and
  // Vitest run, the specs of the scripts under tools/, and the sound lab's
  // page, which the dev server alone serves. @fz/style's Vite plugin imports
  // its modules by their full file names, as Node needs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // tools/*.mjs carry their types in JSDoc; tsconfig.scripts.json checks them.
    "allowJs": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tools/**/*.ts"]
}
