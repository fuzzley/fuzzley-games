{
  // The specs, which Vitest runs. `@fz/dev/layout`, whose shapes the view's
  // layout spec holds the field to, imports its modules by their full file
  // names, as Node needs. Rewriting those names, rather than not emitting,
  // allows them while Analog's plugin still compiles the libraries'
  // Angular code for the specs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts"]
}
