{
  "name": "@fz/phaser",
  "version": "0.0.0",
  "description": "What every game drawn with Phaser shares: the host that keeps one Phaser game and its canvas sharp, the helpers a scene releases itself with, the Angular canvas an app shows a scene in, and real Phaser run headless for specs.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint src vitest.config.ts && yarn lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@fz/style": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fz/dev": "workspace:*",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "phaser": "^4.2.1",
    "postcss": "^8.5.31",
    "rxjs": "~7.8.2",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
