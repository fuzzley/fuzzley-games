{
  "name": "@fz/dev",
  "version": "0.0.0",
  "description": "The lint, compiler, test and build settings, and the script helpers, every workspace shares.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./eslint": "./src/eslint.ts",
    "./vitest": "./src/vitest.ts",
    "./vite": "./src/vite.ts",
    "./game-manifest": "./src/game_manifest.ts",
    "./chrome": "./src/chrome.ts",
    "./layout": "./src/layout.ts",
    "./screenshots": "./src/screenshots.ts",
    "./sounds": "./src/sounds.ts",
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fz/style": "workspace:*",
    "angular-eslint": "^22.6.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@analogjs/vite-plugin-angular": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
