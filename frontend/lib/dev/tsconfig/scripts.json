{
  // A workspace's Node scripts, plain JavaScript type-checked from its JSDoc.
  // Node 26 is the oldest runtime frontend/package.json allows, so its types
  // are the ones installed. A script may import this library's TypeScript,
  // which names its own modules by their full file names, as Node needs.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"]
  }
}
