{
  "name": "@fz/style",
  "version": "0.0.0",
  "description": "The design tokens, palettes and styles the site and the games share.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "sass": "./src/_index.scss"
    },
    "./global": {
      "sass": "./src/global.scss"
    },
    "./tokens": {
      "sass": "./src/tokens/_index.scss"
    },
    "./themes": "./src/themes.ts",
    "./fuzzball": "./src/fuzzball.ts",
    "./vite": "./src/build/vite.ts",
    "./stylelint": "./src/lint/stylelint.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint . && yarn lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "sass": "^1.108.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard-scss": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fz/dev": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "sass": "^1.108.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
