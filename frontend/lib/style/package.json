{
  "name": "@fz/style",
  "version": "0.0.0",
  "description": "The design tokens, palettes and styles the site and the games share.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "sass": "./src/_index.scss"
    },
    "./global": {
      "sass": "./src/global.scss"
    },
    "./tokens": {
      "sass": "./src/tokens/_index.scss"
    },
    "./themes": "./src/themes.ts",
    "./vite": "./src/vite.ts",
    "./stylelint": "./src/stylelint.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && yarn lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0"
  },
  "peerDependencies": {
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard-scss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.0",
    "eslint": "^10.13.0",
    "postcss": "^8.5.31",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
