{
  "name": "@fz/core",
  "version": "0.0.0",
  "description": "The small helpers the games share with no framework and no platform: a seeded random source, readers for stored JSON, counts in words, a clamp, a clock of fixed steps, a log of numbered events and a frame's sounds gathered.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./clock": "./src/clock.ts",
    "./event_log": "./src/event_log.ts",
    "./format": "./src/format.ts",
    "./frame_sounds": "./src/frame_sounds.ts",
    "./json": "./src/json.ts",
    "./math": "./src/math.ts",
    "./random": "./src/random.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@fz/dev": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
