{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Library code stays inside src/: an import that climbs out of it, as one
    // reaching into the site or a game would, fails here.
    "rootDir": "./src",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test-setup.ts"]
}
