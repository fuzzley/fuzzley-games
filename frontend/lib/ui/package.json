    "lint": "eslint src eslint.config.js stylelint.config.js vitest.config.ts && yarn lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@fz/core": "workspace:*",
    "@fz/style": "workspace:*"
  },
  "peerDependencies": {
    "@angular/aria": "~22.2.6",
    "@angular/cdk": "~22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/core": "^22.2.5"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@angular/aria": "~22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cdk": "~22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fz/dev": "workspace:*",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.2",
    "sass": "^1.108.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
