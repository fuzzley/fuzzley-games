{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Library code stays inside src/: an import that climbs out of it, as one
    // reaching into a game would, fails here.
    "rootDir": "./src",
    "types": []
  },
  "include": ["src/**/*.ts"],
  // The specs and their setup, and the helper that imports
  // @fz/style/testing, which needs Node's types: tsconfig.spec.json checks
  // them with those types.
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "src/testing/contrast.ts"
  ]
}
