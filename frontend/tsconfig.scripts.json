{
  // The Node scripts under .agents/ and tools/, type-checked from their JSDoc.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["../.agents/*.mjs", "tools/*.mjs"]
}
