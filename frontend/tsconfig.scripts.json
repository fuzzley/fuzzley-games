{
  // The scripts in .agents/, which belong to no workspace, and the Yarn
  // constraints, type-checked from their JSDoc. The site checks its own
  // scripts with its own copy.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["../.agents/*.mjs", "yarn.config.cjs"]
}
