server {
    listen ${PORT};
    server_name localhost;

    # Ensure redirects (such as adding a trailing slash)
    # are relative so that the internal container port (e.g. :8080) and HTTP scheme are not leaked
    # when running behind a TLS-terminating reverse proxy (Cloud Run).
    absolute_redirect off;
    port_in_redirect off;

    # A folder's index.html has the folder's address, so search engines and
    # analytics see one URL for each page: /play/solitaire/index.html is sent
    # to /play/solitaire/ with its query, and the browser keeps any #hash. It
    # matches the address as sent: `index` and the fallback to /index.html
    # rewrite $uri to …/index.html internally, so matching $uri would loop.
    if ($request_uri ~ "^(?<folder>[^?]*/)index\.html(?:\?|$)") {
        return 301 $folder$is_args$args;
    }

    # The nginx image ships with compression off. HTML is always included once
    # it is on; these are the other text types the site serves.
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Security headers (see nginx/security-headers.conf). Every location below
    # that sets a header of its own has to include them again.
    include /etc/nginx/snippets/security-headers.conf;

    # The site's build fingerprints every file in /assets/, so these files never
    # change in place and browsers can keep them for a year.
    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The games, each built here or fetched from its own repository's release
    # (see frontend/site/games.json), as the site's build put them. They are static pages, not Angular
    # routes, so a missing file is a 404 rather than the site's index.html.
    # Like the site, each fingerprints its assets/ folder, and browsers check
    # back before reusing anything else.
    location /play/ {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;

        location ~ ^/play/[^/]+/assets/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
            include /etc/nginx/snippets/security-headers.conf;
        }
    }

    # Runtime config is regenerated per-deploy; never cache it.
    location = /env.js {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Version info should never be cached.
    location = /version.json {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Angular client-side routing: fall back to index.html for SPA routes.
    # Browsers must check back before reusing index.html: a stale copy would
    # ask for /assets/ files that the next deploy no longer has. The site's
    # pages carry its Content Security Policy.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/content-security-policy.conf;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
